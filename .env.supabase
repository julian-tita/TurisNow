SPRING_DATASOURCE_URL=jdbc:postgresql://db.efnwzwxcsafmtxrafggw.supabase.co:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=7MsD1C-9

