# Frontend Environment Variables

# API URL (default usa proxy de Vite)
# En desarrollo: comentado para usar proxy (/api -> http://localhost:9090/api)
# En producción: descomentar y configurar
# VITE_API_URL=http://localhost:9090

# Google OAuth Client ID
# Obtener de: https://console.cloud.google.com/
# 1. Crear proyecto en Google Cloud Console
# 2. Habilitar Google+ API
# 3. Crear credenciales OAuth 2.0
# 4. Agregar orígenes autorizados:
#    - http://localhost:5173 (desarrollo)
#    - http://localhost:3000 (alternativo)
#    - Tu dominio de producción
# 5. Copiar Client ID aquí
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
